# Set up as the Claude backend for cr-app: read-only reviews on Claude Sonnet 5.5, effort high.
# Local models are not routed through here: cr-app talks to LiteLLM itself (REVIEW_BACKEND=local),
# so leave ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN unset — they would override the credential below.

# --- Claude credential (set ONE) ---
# Subscription (Pro/Max): run `claude setup-token` on your Mac and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Or pay-per-use API key from console.anthropic.com (use this if anyone besides you will call the API):
# ANTHROPIC_API_KEY=

# --- This server's own auth: clients send `Authorization: Bearer <API_TOKEN>` ---
# Generate with: openssl rand -hex 32
API_TOKEN=

# --- Policy ---
# Ceiling: the most tools a single request may enable. cr-app needs only the read-only three;
# the full set is Read,Grep,Glob,Edit,Write,Bash,WebFetch,WebSearch.
MAX_ALLOWED_TOOLS=Read,Grep,Glob
# Used when a request doesn't pass allowed_tools.
DEFAULT_TOOLS=Read,Grep,Glob
# Allow permission_mode "bypassPermissions" (Claude may do anything inside the container).
ALLOW_BYPASS=false
MAX_CONCURRENT_RUNS=2
MAX_TURNS_CEILING=50
# Default model (empty = Claude Code default)
DEFAULT_MODEL=claude-sonnet-5-5
# Reasoning effort: low | medium | high | xhigh | max (empty = model default)
DEFAULT_EFFORT=high
# Ceiling for per-request effort (empty = no limit). Higher effort costs more tokens.
MAX_EFFORT=high

# Browser apps allowed to call the API (comma-separated), e.g. http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- VPS only (docker-compose.vps.yml) ---
# DOMAIN=claude.example.com
# HOST_PORT=8787
