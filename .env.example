# Copy to .env and fill in the two secrets below. Everything else has a sensible default.
# Don't set ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN: they would override the credential below.

# --- Claude credential (set ONE) ---
# Subscription (Pro/Max): run `claude setup-token` on your Mac and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Or pay-per-use API key from console.anthropic.com (use this if anyone besides you will call the API):
# ANTHROPIC_API_KEY=

# --- This server's own auth: clients send `Authorization: Bearer <API_TOKEN>` ---
# Generate with: openssl rand -hex 32
API_TOKEN=

# --- Policy ---
# Ceiling: the most tools a single request may enable.
# Full set: Read,Grep,Glob,Edit,Write,Bash,WebFetch,WebSearch. Add Bash only if you trust every caller:
# it can run any command in the container.
MAX_ALLOWED_TOOLS=Read,Grep,Glob,Edit,Write
# Used when a request doesn't pass allowed_tools (read-only by default).
DEFAULT_TOOLS=Read,Grep,Glob
# Allow permission_mode "bypassPermissions" (Claude may do anything inside the container).
ALLOW_BYPASS=false
MAX_CONCURRENT_RUNS=2
MAX_TURNS_CEILING=50
# Default model (empty = Claude Code default)
DEFAULT_MODEL=claude-sonnet-5-5
# Reasoning effort: low | medium | high | xhigh | max (empty = model default)
DEFAULT_EFFORT=high
# Ceiling for per-request effort (empty = no limit). Higher effort costs more tokens.
MAX_EFFORT=high

# Browser apps allowed to call the API directly (comma-separated), e.g. a Next.js app using useChat.
CORS_ORIGINS=http://localhost:3000

# --- VPS only (docker-compose.vps.yml) ---
# DOMAIN=claude.example.com
# HOST_PORT=8787
